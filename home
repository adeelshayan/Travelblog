<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Travel Blog - Home</title>

    <!--
        This CSS styles the homepage layout, interactive number blocks,
        and nested destination lists to improve readability and usability.
    -->
    <style>
        body {
            font-family: "Segoe UI", Tahoma, Arial, sans-serif;
            margin: 20px;
            background-color: #f4f6f8;
        }

        h1 {
            text-align: center;
            color: #2c3e50;
            margin-bottom: 30px;
        }

        /* Number blocks container */
        .blocks {
            display: flex;
            justify-content: space-around;
            margin-bottom: 50px;
        }

        /* Number block styling */
        .block {
            width: 90px;
            height: 90px;
            color: white;
            font-size: 32px;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            border-radius: 12px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
            transition: transform 0.3s, box-shadow 0.3s;
        }

        .block:hover {
            transform: scale(1.1) translateY(-5px);
            box-shadow: 0 8px 18px rgba(0,0,0,0.25);
        }

        .one { background-color: #e74c3c; }
        .two { background-color: #3498db; }
        .three { background-color: #2ecc71; }
        .four { background-color: #f39c12; }

        /* Continent section styling */
        .continent {
            background-color: #ffffff;
            padding: 20px;
            margin-bottom: 30px;
            border-radius: 10px;
            border-left: 6px solid #3498db;
        }

        h2 {
            color: #2c3e50;
            margin-bottom: 10px;
        }

        /* List styling */
        ol > li {
            margin-bottom: 15px;
            font-weight: bold;
            color: #34495e;
        }

        ul {
            margin-top: 5px;
        }

        ul li {
            margin-left: 15px;
            font-weight: normal;
            color: #7f8c8d;
        }
    </style>
</head>

<body>

<h1>Travel Blog Destinations</h1>

<!-- Interactive Number Blocks -->
<div class="blocks">
    <a href="#europe" class="block one" title="Explore Europe">1</a>
    <a href="#asia" class="block two" title="Explore Asia">2</a>
    <a href="#america" class="block three" title="Explore America">3</a>
    <a href="#africa" class="block four" title="Explore Africa">4</a>
</div>

<!-- Europe -->
<div class="continent" id="europe">
    <h2>Europe</h2>
    <ol>
        <li>France
            <ul>
                <li>Paris</li>
                <li>Lyon</li>
                <li>Nice</li>
            </ul>
        </li>
        <li>Italy
            <ul>
                <li>Rome</li>
                <li>Venice</li>
                <li>Milan</li>
            </ul>
        </li>
        <li>Greece
            <ul>
                <li>Athens</li>
                <li>Santorini</li>
                <li>Mykonos</li>
            </ul>
        </li>
    </ol>
</div>

<!-- Asia -->
<div class="continent" id="asia">
    <h2>Asia</h2>
    <ol>
        <li>Japan
            <ul>
                <li>Tokyo</li>
                <li>Kyoto</li>
                <li>Osaka</li>
            </ul>
        </li>
        <li>China
            <ul>
                <li>Beijing</li>
                <li>Shanghai</li>
                <li>Xi'an</li>
            </ul>
        </li>
        <li>India
            <ul>
                <li>New Delhi</li>
                <li>Mumbai</li>
                <li>Jaipur</li>
            </ul>
        </li>
    </ol>
</div>

<!-- America -->
<div class="continent" id="america">
    <h2>America</h2>
    <ol>
        <li>USA
            <ul>
                <li>New York City</li>
                <li>Los Angeles</li>
                <li>Chicago</li>
            </ul>
        </li>
        <li>Brazil
            <ul>
                <li>Rio de Janeiro</li>
                <li>São Paulo</li>
                <li>Salvador</li>
            </ul>
        </li>
        <li>Canada
            <ul>
                <li>Toronto</li>
                <li>Vancouver</li>
                <li>Montreal</li>
            </ul>
        </li>
    </ol>
</div>

<!-- Africa -->
<div class="continent" id="africa">
    <h2>Africa</h2>
    <ol>
        <li>South Africa
            <ul>
                <li>Cape Town</li>
                <li>Johannesburg</li>
                <li>Durban</li>
            </ul>
        </li>
        <li>Egypt
            <ul>
                <li>Cairo</li>
                <li>Luxor</li>
                <li>Sharm El Sheikh</li>
            </ul>
        </li>
        <li>Morocco
            <ul>
                <li>Marrakech</li>
                <li>Casablanca</li>
                <li>Fez</li>
            </ul>
        </li>
    </ol>
</div>

</body>
</html>


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Travel Stories</title>

    <!--
        This CSS styles the table layout, images, and hover effects
        to enhance readability and visual appeal.
    -->
    <style>
        body {
            font-family: "Segoe UI", Tahoma, Arial, sans-serif;
            margin: 20px;
            background-color: #f4f6f8;
        }

        h1 {
            text-align: center;
            color: #2c3e50;
            margin-bottom: 30px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            border-radius: 10px;
            overflow: hidden;
        }

        caption {
            margin-bottom: 10px;
            font-weight: bold;
            color: #2c3e50;
        }

        th {
            background-color: #34495e;
            color: white;
            padding: 12px;
        }

        td {
            border: 2px solid #3498db;
            padding: 15px;
            text-align: center;
            vertical-align: middle;
        }

        tr:nth-child(even) {
            background-color: #ecf0f1;
        }

        img {
            width: 160px;
            border-radius: 8px;
            transition: opacity 0.3s, transform 0.3s;
        }

        img:hover {
            opacity: 0.7;
            transform: scale(1.05);
        }

        .details {
            margin-top: 50px;
            background-color: #ffffff;
            padding: 20px;
            border-radius: 10px;
        }

        .details h2 {
            color: #2c3e50;
        }
    </style>
</head>

<body>

<h1>Travel Stories</h1>

<!-- Travel destinations table -->
<table>
    <caption>Popular Travel Destinations and Attractions</caption>
    <tr>
        <th>Destination</th>
        <th>Famous Attraction</th>
    </tr>
    <tr>
        <td>Paris</td>
        <td>
            <a href="#paris" title="Learn more about Paris">
                <img src="https://upload.wikimedia.org/wikipedia/commons/a/a8/Tour_Eiffel_Wikimedia_Commons.jpg" alt="Eiffel Tower">
            </a>
        </td>
    </tr>
    <tr>
        <td>Rome</td>
        <td>
            <a href="#rome" title="Learn more about Rome">
                <img src="https://images.pexels.com/photos/3762321/pexels-photo-3762321.jpeg" alt="Colosseum">
            </a>
        </td>
    </tr>
    <tr>
        <td>New York</td>
        <td>
            <a href="#ny" title="Learn more about New York">
                <img src="https://upload.wikimedia.org/wikipedia/commons/a/a1/Statue_of_Liberty_7.jpg" alt="Statue of Liberty">
            </a>
        </td>
    </tr>
</table>

<!-- Destination details -->
<div class="details">
    <h2 id="paris">Paris</h2>
    <p>Paris is renowned for its culture, art, and architecture, with the Eiffel Tower being one of the most recognizable landmarks in the world.</p>

    <h2 id="rome">Rome</h2>
    <p>Rome is a historic city that showcases ancient Roman civilization, especially through landmarks such as the Colosseum.</p>

    <h2 id="ny">New York</h2>
    <p>New York City is a global destination famous for its skyline, cultural diversity, and the Statue of Liberty.</p>
</div>

</body>
</html>
